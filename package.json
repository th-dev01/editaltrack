{
  "name": "editaltrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test:auth": "playwright test",
    "auth:recovery-code": "node --env-file=.env.recovery.local scripts/dev-recovery-code.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
