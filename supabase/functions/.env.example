# Exemplo local para `supabase functions serve --env-file supabase/functions/.env.local`.
# Copie para .env.local (ignorado pelo Git) e preencha; não use valores reais neste arquivo.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:54321/functions/v1/google-oauth-callback
APP_URL=http://localhost:5173
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
